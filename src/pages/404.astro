---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../site';
---

<Base title="Page not found">
  <header class="page-hero">
    <div class="container">
      <h1>Page not found</h1>
      <p class="lede">We couldn't find that page. It may have moved while the site is being rebuilt.</p>
    </div>
  </header>
  <div class="container page-body">
    <p><a class="btn btn-primary" href={url('/')}>Go to the home page <Icon name="arrow-right" size={18} /></a></p>
  </div>
</Base>
